# Environment
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHANNEL_ID=@your_channel_or_-100xxxx
TELEGRAM_MODERATION_CHANNEL_ID=@your_moderation_channel
ADMIN_USER_ID=your_telegram_user_id

# OpenRouter for AI rewriting
OPENROUTER_API_KEY=your_openrouter_key
LLM_MODEL=google/gemini-3-flash-preview

# Settings
POST_INTERVAL_MINUTES=180
BATCH_SIZE=5
MAX_POSTS_PER_DAY=20
AUTO_POST=false
TONE_PROMPT={"persona":"Tech-эксперт","voice":"разговорный","mood":"дружелюбный"}
